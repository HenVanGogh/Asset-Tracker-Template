menuconfig APP_FOTA
	bool "FOTA via HTTP/HTTPS (MQTT-triggered)"
	default n
	help
	  Enable HTTP/HTTPS firmware update triggered by an MQTT command.
	  Does NOT require nRF Cloud. The device downloads the binary from
	  any HTTP/HTTPS URL, writes it to the MCUboot secondary slot, and
	  reboots to apply.

if APP_FOTA

config APP_FOTA_URL_MAX_LEN
	int "Maximum length of FOTA download URL"
	default 256

config APP_FOTA_SEC_TAG
	int "Default TLS security tag for FOTA downloads"
	default -1
	help
	  Set to -1 to disable TLS certificate verification (plain HTTP or
	  unverified HTTPS — development only).
	  Set to a provisioned modem sec_tag (>= 0) to enable TLS certificate
	  verification for HTTPS downloads.
	  The CA certificate must be provisioned at this tag using AT%CMNG
	  before the FOTA update is triggered.
	  The MQTT command can override this value per-request.

config APP_FOTA_THREAD_STACK_SIZE
	int "Thread stack size"
	default 4096

config APP_FOTA_WATCHDOG_TIMEOUT_SECONDS
	int "Watchdog timeout"
	default 600
	help
	  Timeout in seconds for the FOTA module watchdog.
	  Must be greater than APP_FOTA_MSG_PROCESSING_TIMEOUT_SECONDS.
	  A typical firmware download over LTE-M for a 350KB image takes
	  30–120 seconds. 600 seconds (10 minutes) gives ample margin.

config APP_FOTA_MSG_PROCESSING_TIMEOUT_SECONDS
	int "Maximum message processing time"
	default 540
	help
	  Maximum time allowed for processing a single message.
	  Must be smaller than APP_FOTA_WATCHDOG_TIMEOUT_SECONDS.

module = APP_FOTA
module-str = FOTA
source "subsys/logging/Kconfig.template.log_config"

endif # APP_FOTA
