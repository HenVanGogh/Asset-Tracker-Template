/* #include <thingy91x_wifi.dtsi> */

/* UART0 for USB logging via nRF5340 connectivity bridge */
&uart0 {
	status = "okay";
	current-speed = <115200>;
};

&bme680 {
	status = "okay";
};

/* UART1 was the inter-chip link to nRF5340. It is replaced by SPI.
 * P0.05 (was UART1 TX) → SPI CS GPIO for nRF5340
 * P0.04 (was UART1 RX) → DATA_READY interrupt input from nRF5340
 */
&uart1 {
        status = "disabled";
};

/ {
/*
        chosen {
                zephyr,wifi = &nordic_wlan0;
        };
*/
        zephyr,user {
                /* SPI CS for nRF5340 SPIS slave (P0.05, active LOW) */
                esl-ap-cs-gpios    = <&gpio0 5 GPIO_ACTIVE_LOW>;
                /* DATA_READY interrupt from nRF5340 (P0.04, active HIGH) */
                esl-ap-drdy-gpios  = <&gpio0 4 GPIO_ACTIVE_HIGH>;
        };
};
